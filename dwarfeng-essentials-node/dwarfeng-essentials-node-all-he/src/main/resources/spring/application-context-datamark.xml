            update-allowed="${com.dwarfeng.essentials.datamark.notify.user.update_allowed}"
    />

    <!-- endregion -->

    <!-- QoS 服务。 -->
    <datamark:qos/>

    <!-- 监听器解析器。 -->
    <bean name="packagePrefixListenerResolver"
          class="com.dwarfeng.essentials.sdk.datamark.PackagePrefixListenerResolver"/>
</beans>
