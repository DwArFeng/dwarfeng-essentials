<?xml version="1.0" encoding="UTF-8"?>
<beans
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns:datamark="http://dwarfeng.com/schema/dwarfeng-datamark"
        xmlns="http://www.springframework.org/schema/beans"
        xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://dwarfeng.com/schema/dwarfeng-datamark
        http://dwarfeng.com/schema/dwarfeng-datamark/dwarfeng-datamark.xsd"
>

    <!-- region acckeeper -->

    <!-- Account 数据标识。 -->
    <datamark:handler
            handler-name="acckeeper.accountDatamarkHandler"
            resource-url="${com.dwarfeng.essentials.datamark.acckeeper.account.resource_url}"
            resource-charset="${com.dwarfeng.essentials.datamark.acckeeper.account.resource_charset}"
            update-allowed="${com.dwarfeng.essentials.datamark.acckeeper.account.update_allowed}"
    />

